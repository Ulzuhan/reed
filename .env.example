# Reed configuration — copy to .env and adjust. Every setting is a REED_* env var.

# ---------------------------------------------------------------------------
# Provider profile
# ---------------------------------------------------------------------------
# openai — OpenAI API for chat and embeddings (needs OPENAI_API_KEY)
# local  — Ollama on your own machine, nothing leaves it
# fake   — deterministic stub models, for tests and UI development
REED_PROFILE=openai

# OpenAI (profile=openai)
OPENAI_API_KEY=
REED_OPENAI_CHAT_MODEL=gpt-5-mini
REED_OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (profile=local)
REED_OLLAMA_BASE_URL=http://localhost:11434
REED_OLLAMA_CHAT_MODEL=qwen3.5:4b
REED_OLLAMA_EMBED_MODEL=embeddinggemma

# Optional immutable identity overrides. Ollama normally resolves digest and
# quantization from /api/tags; hosted/custom models can pin a revision here.
REED_EMBED_MODEL_DIGEST=
REED_EMBED_MODEL_REVISION=
REED_EMBED_MODEL_QUANTIZATION=

# Embedding task prefixes. EmbeddingGemma expects a query prefix; Reed injects
# the real filename and section into document embedding input automatically.
# Leave unset for model-aware defaults, set to "" to disable explicitly.
# REED_EMBED_QUERY_PREFIX=task: search result | query:
# REED_EMBED_DOC_PREFIX=

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
# Leave REED_QDRANT_URL empty to use embedded Qdrant (a local folder, no server).
REED_QDRANT_URL=
REED_QDRANT_API_KEY=
REED_COLLECTION=reed_chunks

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
REED_TOP_K=4
REED_FETCH_K=20
REED_RETRIEVAL_MODE=hybrid
REED_RERANK_ENABLED=false
# Multilingual Apache-2.0 reranking is an opt-in install: `uv sync --extra rerank`
# from a checkout, or `pip install 'reed[rerank]'` for the wheel.
REED_RERANK_BACKEND=sentence_transformers
REED_RERANK_MODEL=BAAI/bge-reranker-v2-m3
REED_SPARSE_MODEL=Qdrant/bm25
REED_MAX_CONTEXT_CHARS=24000
REED_MAX_CHUNKS_PER_DOCUMENT=2
REED_DIVERSITY_ENABLED=true
REED_DIVERSITY_LAMBDA=0.7
# Unset selects 0.8333333333333333 only for local hybrid + EmbeddingGemma;
# other score domains default to 0. Re-run `reed eval` after changing model/mode.
# REED_MIN_EVIDENCE_SCORE=0.8333333333333333

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
REED_CHUNK_SIZE=1000
REED_CHUNK_OVERLAP=150
REED_MAX_UPLOAD_MB=25
REED_MAX_MULTIPART_OVERHEAD_KB=256
REED_MAX_DOCUMENT_CHARS=5000000
REED_MAX_PDF_PAGES=1000
REED_PARSER_TIMEOUT_SECONDS=30
REED_PARSER_CPU_SECONDS=20
REED_PARSER_MEMORY_MB=1024

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
REED_DATA_DIR=./data
REED_HOST=127.0.0.1
REED_PORT=8000
REED_LOG_LEVEL=INFO
REED_TEMPERATURE=0.1
# Provider request and output limits.
REED_PROVIDER_TIMEOUT_SECONDS=120
REED_STARTUP_GRACE_SECONDS=2
REED_READINESS_RETRY_INITIAL_SECONDS=2
REED_READINESS_RETRY_MAX_SECONDS=60
REED_READINESS_CHAT_TTL_SECONDS=15
# /ready probes Ollama with its own short timeout, not the generation one.
REED_READINESS_PROBE_TIMEOUT_SECONDS=5
REED_MAX_OUTPUT_TOKENS=1024
# Per-process concurrency and per-client/minute limits (0 disables a rate limit).
REED_MAX_CONCURRENT_ASKS=8
REED_MAX_CONCURRENT_INGESTIONS=2
REED_MAX_QUEUED_INGESTIONS=16
REED_ASK_RATE_LIMIT_PER_MINUTE=60
REED_UPLOAD_RATE_LIMIT_PER_MINUTE=20
REED_SSE_QUEUE_SIZE=64
REED_MAX_JSON_BODY_KB=128
# Compose stores both the multipart spool and Reed's staged upload in /tmp.
# Budget at least 2 × REED_MAX_UPLOAD_MB plus multipart overhead.
REED_TMPFS_SIZE=64m
# Set to require an X-API-Key header on /v1/* routes. Empty means no auth.
REED_API_KEY=
REED_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
REED_EVAL_JUDGE_PROFILE=openai
REED_EVAL_JUDGE_MODEL=
