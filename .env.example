# Reed configuration — copy to .env and adjust. Every setting is a REED_* env var.

# ---------------------------------------------------------------------------
# Provider profile
# ---------------------------------------------------------------------------
# openai — OpenAI API for chat and embeddings (needs OPENAI_API_KEY)
# local  — Ollama on your own machine, nothing leaves it
# fake   — deterministic stub models, for tests and UI development
REED_PROFILE=openai

# OpenAI (profile=openai)
OPENAI_API_KEY=
REED_OPENAI_CHAT_MODEL=gpt-5-mini
REED_OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (profile=local)
REED_OLLAMA_BASE_URL=http://localhost:11434
REED_OLLAMA_CHAT_MODEL=qwen3.5:4b
REED_OLLAMA_EMBED_MODEL=embeddinggemma

# Embedding task prefixes. EmbeddingGemma expects them; OpenAI does not.
# Leave unset to use the profile defaults, set to "" to disable explicitly.
# REED_EMBED_QUERY_PREFIX=task: search result | query:
# REED_EMBED_DOC_PREFIX=title: none | text:

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
# Leave REED_QDRANT_URL empty to use embedded Qdrant (a local folder, no server).
REED_QDRANT_URL=
REED_QDRANT_API_KEY=
REED_COLLECTION=reed_chunks

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
REED_TOP_K=4
REED_FETCH_K=20
REED_RERANK_ENABLED=false
REED_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
REED_SPARSE_MODEL=Qdrant/bm25
REED_MAX_CONTEXT_CHARS=24000

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
REED_CHUNK_SIZE=1000
REED_CHUNK_OVERLAP=150
REED_MAX_UPLOAD_MB=25
REED_MAX_MULTIPART_OVERHEAD_KB=256
REED_MAX_DOCUMENT_CHARS=5000000
REED_MAX_PDF_PAGES=1000
REED_PARSER_TIMEOUT_SECONDS=30
REED_PARSER_CPU_SECONDS=20
REED_PARSER_MEMORY_MB=1024

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
REED_DATA_DIR=./data
REED_HOST=127.0.0.1
REED_PORT=8000
REED_LOG_LEVEL=INFO
REED_TEMPERATURE=0.1
# Provider request and output limits.
REED_PROVIDER_TIMEOUT_SECONDS=120
REED_STARTUP_GRACE_SECONDS=0.25
REED_READINESS_RETRY_INITIAL_SECONDS=2
REED_READINESS_RETRY_MAX_SECONDS=60
REED_MAX_OUTPUT_TOKENS=1024
# Per-process concurrency and per-client/minute limits (0 disables a rate limit).
REED_MAX_CONCURRENT_ASKS=8
REED_MAX_CONCURRENT_INGESTIONS=2
REED_ASK_RATE_LIMIT_PER_MINUTE=60
REED_UPLOAD_RATE_LIMIT_PER_MINUTE=20
REED_SSE_QUEUE_SIZE=64
REED_MAX_JSON_BODY_KB=128
# Set to require an X-API-Key header on /v1/* routes. Empty means no auth.
REED_API_KEY=
REED_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
REED_EVAL_JUDGE_PROFILE=openai
REED_EVAL_JUDGE_MODEL=
